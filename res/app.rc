#include <windows.h>

101 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

2 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "MathPaperStudio"
            VALUE "FileDescription", "MathPaperStudio - Math Paper Composer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "MathPaperStudio"
            VALUE "OriginalFilename", "MathPaperStudio.exe"
            VALUE "ProductName", "MathPaperStudio"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
